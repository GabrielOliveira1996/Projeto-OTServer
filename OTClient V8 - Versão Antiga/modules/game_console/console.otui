ConsoleTabBar < TabBar
  height: 24
  anchors.top: parent.top
  anchors.left: parent.left
  anchors.right: parent.right

ConsoleTabBarButton < TabBarButton
  font: verdana-11px-antialised
  color: #aaaaaa
  size: 85 24
  text-offset: 0 2
  anchors.top: parent.top
  anchors.left: parent.left
  
  $checked:
    color: #fd8f00

Panel
  id: consolePanel
  image-source: /images/ui/panel_bottom
  image-border: 40
  height: 180
  width: 300
  anchors.left: parent.left
  anchors.bottom: parent.bottom
  margin-left: 50
  margin-bottom: 20
  focusable: false

  UIWidget
    id: sayModeButton
    visible: false
    &sayMode: 2
    
  ConsoleTabBar
    id: consoleTabBarPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right

  Panel
    id: consoleContentPanel
    anchors.top: consoleTabBarPanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: consoleTextEdit.top
    image-source: /images/ui/panel_flat
    image-border: 2
    background-color: #000000aa
    margin-top: 1

  TextEdit
    id: consoleTextEdit
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 20
    margin-left: 5
    margin-right: 5
    margin-bottom: 5
    shift-navigation: true
    font: verdana-11px-antialised
    focusable: true
    phantom: false
    auto-focus: true
    image-source: /images/ui/panel_flat
    image-border: 1
    padding: 2

  UIWidget
    id: toggleChat
    visible: false
  UIWidget
    id: prevChannelButton
    visible: false
  UIWidget
    id: nextChannelButton
    visible: false
  UIWidget
    id: closeChannelButton
    visible: false