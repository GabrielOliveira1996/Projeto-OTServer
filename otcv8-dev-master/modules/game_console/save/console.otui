ConsoleTabBar < TabBar
  height: 24
  anchors.top: parent.top
  anchors.left: parent.left
  anchors.right: parent.right

ConsoleTabBarButton < TabBarButton
  font: verdana-11px-antialised
  color: #aaaaaa
  size: 85 24
  text-offset: 0 2
  anchors.top: parent.top
  anchors.left: parent.left
  
  $checked:
    color: #f7f7f7

Panel
  id: consolePanel
  image-source: /images/ui/panel_bottom
  height: 180
  width: 300
  anchors.left: parent.left
  anchors.bottom: parent.bottom
  margin-left: 50
  margin-bottom: 50
  focusable: false
  phantom: false

  UIWidget
    id: sayModeButton
    visible: false
    
  ConsoleTabBar
    id: consoleTabBarPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    phantom: true

  Panel
    id: consoleContentPanel
    anchors.top: consoleTabBarPanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: consoleTextEdit.top
    image-border: 2
    background-color: #000000aa
    margin-top: 1
    phantom: true

  TextEdit
    id: consoleTextEdit
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 22
    margin-left: 2
    margin-right: 2
    margin-bottom: 1
    shift-navigation: true
    font: verdana-11px-antialised
    image-source: /images/ui/panel_flat
    image-border: 1
    padding: 2
    phantom: false
    focusable: true
    editable: true
    auto-focus: true
    @onSetup: |
      self:setFocusable(true)
      self:setPhantom(false)

  UIWidget
    id: toggleChat
    visible: false
  UIWidget
    id: prevChannelButton
    visible: false
  UIWidget
    id: nextChannelButton
    visible: false
  UIWidget
    id: closeChannelButton
    visible: false